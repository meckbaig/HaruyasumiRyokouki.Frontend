# API base path. Keep /v1 in development — vite proxies it to BACKEND_ORIGIN.
VITE_API_BASE_URL=/v1

# Proxy target for /v1 in development (never bundled).
BACKEND_ORIGIN=http://localhost:5101

VITE_BASE_MAP_FROM=2026-02-26
VITE_BASE_MAP_TO=2026-05-24

# Basemap provider: `maptoolkit` (default), `openfreemap` or `carto`. Every
# provider is a MapLibre style, so the engine is the same for all of them.
VITE_MAP_PROVIDER=openfreemap

# Override the style or tile URL for one scheme, e.g. a keyed provider. Unset,
# each scheme takes the provider's default; MapToolkit's are hosted under /map.
# VITE_MAP_STYLE_LIGHT=/map/maptoolkit-light.json
# VITE_MAP_STYLE_DARK=/map/maptoolkit-dark.json
# VITE_MAP_ATTRIBUTION=&copy; OpenStreetMap contributors

# Site icons drawn before a link in a note. `{domain}` is the link's host; point
# this at a self-hosted proxy so the reader's browser talks to nobody else.
# VITE_FAVICON_URL=https://icons.duckduckgo.com/ip3/{domain}.ico

# Developer links rendered in the footer.
VITE_AUTHOR_NAME=meckbaig
VITE_AUTHOR_GITHUB=https://github.com/meckbaig
